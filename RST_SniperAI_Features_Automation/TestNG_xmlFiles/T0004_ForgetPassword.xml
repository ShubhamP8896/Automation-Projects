<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ForgetPasswordSuite">
<listeners>
	<listener class-name="com.qa_0001_TestListeners.TL_001_TestListeners"></listener>
</listeners>
<parameter name="sheetName" value="ForgetPassword"></parameter>
  <test name="ForgetPasswordTest" parallel="classes" thread-count="2">
    <classes>
      <class name="com.qa_0004_ForgetPassword.TC0001_VerifyRecForgetPassword_validRecEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0005_VerifyCanForgetPassword_validCanEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0009_VerifyRecForgetPassword_WithCanEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0010_VerifyCanForgetPassword_WithRecEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0011_VerifyRecForgetPassword_InvalidEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0012_VerifyCanForgetPassword_InvalidEmail"/>
      <class name="com.qa_0004_ForgetPassword.TC0013_VerifyRecForgetPassword_WithoutEmail"/> 
      <class name="com.qa_0004_ForgetPassword.TC0014_VerifyCanForgetPassword_WithoutEmail"/>
    </classes>
  </test> <!-- ForgetPasswordTest -->
</suite> <!-- ForgetPasswordSuite -->
