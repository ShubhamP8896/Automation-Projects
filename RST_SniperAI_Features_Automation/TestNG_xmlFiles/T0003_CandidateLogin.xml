<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="candidateLoginSuite">
	<parameter name="sheetName" value="CandidateModule_Login"></parameter>
	<listeners>
		<listener class-name="com.qa_0001_TestListeners.TL_001_TestListeners"></listener>
	</listeners>
  <test name="candidateLoginTest" parallel="classes" thread-count="2">
    <classes>
      <class name="com.qa_0003_CandidateLogin.TC0001_VerifyCanLogin_validCred"/>
      <class name="com.qa_0003_CandidateLogin.TC0002_VerifyCanLogin_InvalidPass"/>
      <class name="com.qa_0003_CandidateLogin.TC0003_VerifyCanLogin_InvalidUsername"/>
      <class name="com.qa_0003_CandidateLogin.TC0004_VerifyCanLogin_InvalidCred"/>
      <class name="com.qa_0003_CandidateLogin.TC0005_VerifyCanLogin_WithoutUsername"/>
      <class name="com.qa_0003_CandidateLogin.TC0006_VerifyCanLogin_WithoutPassword"/>
      <class name="com.qa_0003_CandidateLogin.TC0007_VerifyCanLogin_WithoutCred"/>
      <class name="com.qa_0003_CandidateLogin.TC0008_VerifyCanLogin_WithRecCred"/>
    </classes>
  </test> <!-- candidateLoginTest -->
</suite> <!-- candidateLoginSuite -->
